<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <appSettings>
    <add key="WSGI_HANDLER" value="satark.wsgi.application" />
    <add key="PYTHONPATH" value="C:\inetpub\wwwroot\sonata_satark_be\satark" />
    <add key="DJANGO_SETTINGS_MODULE" value="satark.settings" />
  </appSettings>
  <system.webServer>
    <handlers>
      <add name="Python FastCGI"
           path="*"
           verb="*"
           modules="FastCgiModule"
           scriptProcessor="C:\inetpub\wwwroot\sonata_satark_be\env\Scripts\python.exe|C:\inetpub\wwwroot\sonata_satark_be\env\Lib\site-packages\wfastcgi.py"
           resourceType="Unspecified" />
    </handlers>
  </system.webServer>
</configuration>